{
  "expo": {
    "name": "Wishsite",
    "slug": "wishsiteapp",
    "version": "1.0.0",
    "scheme": "net.wishsite.app",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FBF9F9"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "net.wishsite.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSAllowsLocalNetworking": true
        },
        "NSFaceIDUsageDescription": "Wishsite nutzt Face ID, um deine wishsites vor fremdem Zugriff auf diesem Gerät zu schützen."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "net.wishsite.app",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Wishsite benötigt Zugriff auf deine Fotos, um ein Hintergrund- oder Profilbild für deine wishsite auszuwählen."
        }
      ],
      [
        "expo-media-library",
        {
          "savePhotosPermission": "Wishsite benötigt Zugriff auf deine Fotos, um den QR-Code zu speichern.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "expo-share-intent",
        {
          "iosActivationRules": {
            "NSExtensionActivationSupportsWebURLWithMaxCount": 1,
            "NSExtensionActivationSupportsWebPageWithMaxCount": 1
          },
          "iosShareExtensionName": "ShareExtension"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#ffffff"
        }
      ],
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "04efd8eb-a257-4f51-b249-50ad19d1344f"
      }
    },
    "owner": "anaiccials-organization"
  }
}
